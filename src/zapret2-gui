SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/StatusNotifierItem/menu"
WATCHER = "org.kde.StatusNotifierWatcher"


class Tray:
    """Tray icon. `available` is True while a tray host shows it."""

    def __init__(self, on_activate, on_change=None):
        self.on_activate = on_activate
        self.on_change = on_change
        self.available = False
        self.bus = None
        self.reg_ids = []
        self.icon = "zapret2-gui"
        self.tooltip = APP_NAME
        self.revision = 1
        self.items = []  # list of dicts: id, label, callback, toggle, enabled, separator
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            return
        self.sni_info = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        self.menu_info = Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0]
        self.watch = Gio.bus_watch_name_on_connection(
            self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE, self._watcher_up, self._watcher_down)

    # ---- menu model

    def set_menu(self, items):
        self.items = items
        self.revision += 1
        self._emit(MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated",
                   GLib.Variant("(ui)", (self.revision, 0)))

    def set_state(self, icon, tooltip):
        if icon != self.icon:
            self.icon = icon
            self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewIcon", None)
        if tooltip != self.tooltip:
            self.tooltip = tooltip
            self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewToolTip", None)
            self._emit(SNI_PATH, "org.kde.StatusNotifierItem", "NewTitle", None)

    def _props(self, item):
        if item.get("separator"):
            return {"type": GLib.Variant("s", "separator")}
        p = {"label": GLib.Variant("s", item["label"]),
             "enabled": GLib.Variant("b", item.get("enabled", True)),
             "visible": GLib.Variant("b", True)}
        if "toggle" in item:
            p["toggle-type"] = GLib.Variant("s", "checkmark")
            p["toggle-state"] = GLib.Variant("i", 1 if item["toggle"] else 0)
        return p

    # ---- registration

    def _watcher_up(self, *_a):
        self._register()

    def _watcher_down(self, *_a):
        self._unregister()

    def _register(self):
        self._unregister()
        try:
            self.reg_ids = [
                self.bus.register_object(MENU_PATH, self.menu_info, self._menu_call, self._menu_prop, None),
                self.bus.register_object(SNI_PATH, self.sni_info, self._sni_call, self._sni_prop, None),
            ]
            self.bus.call_sync(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
                               GLib.Variant("(s)", (self.bus.get_unique_name(),)), None,
                               Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            self._unregister()
            return
        self.available = True
        if self.on_change:
            self.on_change(True)

    def _unregister(self):
        for rid in self.reg_ids:
            self.bus.unregister_object(rid)
        self.reg_ids = []
        was = self.available
        self.available = False
        if was and self.on_change:
            self.on_change(False)

    def _emit(self, path, iface, name, params):
        if not self.available:
            return
        try:
            self.bus.emit_signal(None, path, iface, name, params)
        except GLib.Error:
            pass

    # ---- org.kde.StatusNotifierItem

    def _sni_prop(self, _c, _s, _p, _i, name):
        values = {
            "Category": GLib.Variant("s", "ApplicationStatus"),
            "Id": GLib.Variant("s", "zapret2-gui"),
            "Title": GLib.Variant("s", self.tooltip),
            "Status": GLib.Variant("s", "Active"),
            "IconName": GLib.Variant("s", self.icon),
            "IconThemePath": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (self.icon, [], APP_NAME, self.tooltip)),
            "Menu": GLib.Variant("o", MENU_PATH),
            "ItemIsMenu": GLib.Variant("b", False),
        }
        return values.get(name)

    def _sni_call(self, _c, _s, _p, _i, method, params, invocation):
        if method in ("Activate", "SecondaryActivate"):
            GLib.idle_add(lambda: self.on_activate() and False)
        invocation.return_value(None)

    # ---- com.canonical.dbusmenu

    def _menu_prop(self, _c, _s, _p, _i, name):
        return {"Version": GLib.Variant("u", 3), "TextDirection": GLib.Variant("s", "ltr"),
                "Status": GLib.Variant("s", "normal"), "IconThemePath": GLib.Variant("as", [])}.get(name)

    def _layout(self):
        children = [GLib.Variant("(ia{sv}av)", (it["id"], self._props(it), [])) for it in self.items]
        return (0, {"children-display": GLib.Variant("s", "submenu")}, children)

    def _menu_call(self, _c, _s, _p, _i, method, params, invocation):
        if method == "GetLayout":
            invocation.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self._layout())))
        elif method == "GetGroupProperties":
            ids = params.unpack()[0]
            res = [(it["id"], self._props(it)) for it in self.items if not ids or it["id"] in ids]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (res,)))
        elif method == "GetProperty":
            iid, name = params.unpack()
            it = next((i for i in self.items if i["id"] == iid), None)
            val = self._props(it).get(name) if it else None
            invocation.return_value(GLib.Variant("(v)", (val or GLib.Variant("s", ""),)))
        elif method == "Event":
            iid, ev = params.unpack()[:2]
            if ev == "clicked":
                self._click(iid)
            invocation.return_value(None)
        elif method == "EventGroup":
            for iid, ev, _d, _t in params.unpack()[0]:
                if ev == "clicked":
                    self._click(iid)
            invocation.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            invocation.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            invocation.return_value(GLib.Variant("(aiai)", ([], [])))
        else:
            invocation.return_value(None)

    def _click(self, iid):
        it = next((i for i in self.items if i["id"] == iid), None)
        if it and it.get("callback") and it.get("enabled", True):
            GLib.idle_add(lambda: it["callback"]() and False)


# ------------------------------------------------------------------ UI helpers

def label(text="", classes=(), wrap=True, xalign=0.5, selectable=False):
    lb = Gtk.Label(label=text, wrap=wrap, xalign=xalign, justify=Gtk.Justification.CENTER
                   if xalign == 0.5 else Gtk.Justification.LEFT, selectable=selectable)
    lb.set_wrap_mode(2)  # Pango.WrapMode.WORD_CHAR
    for c in classes:
        lb.add_css_class(c)
    return lb


def pill(text, suggested=True):
    b = Gtk.Button(label=text, halign=Gtk.Align.CENTER)
    b.add_css_class("pill")
    if suggested:
        b.add_css_class("suggested-action")
    return b


def page_box():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, valign=Gtk.Align.CENTER,
                  margin_top=24, margin_bottom=32, margin_start=32, margin_end=32)
    clamp = Adw.Clamp(maximum_size=420, child=box)
    scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp,
                                  propagate_natural_height=True)
    return scroller, box


def app_icon():
    img = Gtk.Image(icon_name="zapret2-gui", pixel_size=96, halign=Gtk.Align.CENTER)
    img.set_margin_bottom(12)
    return img


def hero(icon_name, pixel_size=56):
    frame = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.add_css_class("hero")
    img = Gtk.Image(icon_name=icon_name, pixel_size=pixel_size, hexpand=True, vexpand=True,
                    halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.append(img)
    frame.set_margin_bottom(12)
    return frame, img


def make_spinner():
    if hasattr(Adw, "Spinner"):
        sp = Adw.Spinner()
        sp.set_size_request(56, 56)
        return sp
    sp = Gtk.Spinner(spinning=True)
    sp.set_size_request(56, 56)
    return sp


def fmt_elapsed(sec):
    return f"{sec // 60}:{sec % 60:02d}"


def fmt_date(ts):
    try:
        return time.strftime("%b %-d, %Y", time.localtime(int(ts)))
    except (TypeError, ValueError):
        return ""


# ------------------------------------------------------------------ window

class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME, default_width=500, default_height=640)
        self.set_size_request(360, 480)
        self.run = None
        self.task = None
        self.timer = None
        self.started = 0
        self.tested = 0
        self.switch_guard = False
        self.authed = False

        self.toasts = Adw.ToastOverlay()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Adw.HeaderBar()
        header.set_decoration_layout(":close")
        header.set_title_widget(Adw.WindowTitle(title=APP_NAME))
        menu = Gio.Menu()
        menu.append("Update zapret2", "win.update")
        menu.append("About", "win.about")
        self.menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                          tooltip_text="Menu")
        header.pack_start(self.menu_button)
        outer.append(header)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=220, vexpand=True)
        outer.append(self.stack)
        self.toasts.set_child(outer)
        self.set_content(self.toasts)

        for name, fn in (("update", self.on_update), ("about", self.on_about)):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", lambda *_a, f=fn: f())
            self.add_action(act)

        self._build_missing()
        self._build_welcome()
        self._build_working()
        self._build_home()
        self._build_error()
        self.connect("close-request", self.on_close_request)
        # Bypass can be stopped from outside; re-check when the window gets focus.
        self.connect("notify::is-active", lambda *_a: self.is_active() and
                     self.stack.get_visible_child_name() == "home" and self.refresh())
        self.refresh()

    # ---------------------------------------------------------- pages

    def _build_missing(self):
        sc, box = page_box()
        box.append(app_icon())
        box.append(label("Finish setting up", ["title-1"]))
        box.append(label("Zapret2 needs to download and install its unblocking engine. "
                         "You will be asked for your password.", ["dim-label", "status-line"]))
        btn = pill("Install")
        btn.set_margin_top(18)
        btn.connect("clicked", lambda _b: self.start_install())
        box.append(btn)
        self.stack.add_named(sc, "missing")

    def _build_welcome(self):
        sc, box = page_box()
        box.append(app_icon())
        box.append(label("Unblock websites and apps", ["title-1"]))
        box.append(label("Type websites that don't open for you. For a blocked app, type the website "
                         "it uses, like discord.com. Zapret2 tries different ways around the block and "
                         "keeps the one that works. This takes a few minutes.",
                         ["dim-label", "status-line"]))
        self.domain_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, margin_top=18)
        self.domain_list.add_css_class("boxed-list")
        self.entries = []
        self.add_row = Adw.ActionRow(title="Add another website", activatable=True)
        self.add_row.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
        self.add_row.connect("activated", lambda _r: self.add_entry(focus=True))
        self.domain_list.append(self.add_row)
