# Maintainer: 360900 <ziyad.koca@hotmail.com>
pkgname=zapret2-gui
pkgver=1.0.0
pkgrel=1
pkgdesc='One-click DPI bypass for blocked websites, powered by zapret2'
arch=('any')
url='https://github.com/360900/zapret2-gui'
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'curl' 'nftables' 'polkit' 'procps-ng' 'bind')
install=zapret2-gui.install
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 src/zapret2-gui "$pkgdir/opt/zapret2-gui/zapret2-gui"
	install -Dm755 src/zapret2-gui-helper "$pkgdir/opt/zapret2-gui/zapret2-gui-helper"
	install -d "$pkgdir/usr/bin"
	ln -s /opt/zapret2-gui/zapret2-gui "$pkgdir/usr/bin/zapret2-gui"
	install -Dm644 data/zapret2-gui.desktop "$pkgdir/usr/share/applications/zapret2-gui.desktop"
	install -Dm644 data/zapret2-gui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zapret2-gui.svg"
	install -Dm644 data/org.zapret2gui.policy "$pkgdir/usr/share/polkit-1/actions/org.zapret2gui.policy"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
