# ------------------------------------------------------------------ oneDesign colors
# Mirrors oneDesign tokens/one.json + tools/onetokens.py (blue accent).

def _oklch(L, C, H, a=1.0):
    h = math.radians(H)
    A, B = C * math.cos(h), C * math.sin(h)
    l_ = L + 0.3963377774 * A + 0.2158037573 * B
    m_ = L - 0.1055613458 * A - 0.0638541728 * B
    s_ = L - 0.0894841775 * A - 1.2914855480 * B
    l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
    lin = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
           -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
           -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)

    def g(x):
        x = min(max(x, 0.0), 1.0)
        return 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055

    r, gg, b = (round(g(v) * 255) for v in lin)
    return f"#{r:02x}{gg:02x}{b:02x}" if a >= 1 else f"rgba({r},{gg},{b},{a:.3f})"


def one_colors(dark):
    hue, chroma, nc = 255, 0.16, 0.006
    n = ({"canvas": 0.215, "surface": 0.25, "surfaceAlt": 0.285, "float": 0.28, "headerbar": 0.215, "text": 0.96}
         if dark else
         {"canvas": 0.975, "surface": 1.0, "surfaceAlt": 0.965, "float": 0.99, "headerbar": 0.975, "text": 0.2})
    aL = 0.74 if dark else 0.56
    st = 0.74 if dark else 0.56
    c = {k: _oklch(v, nc * (2 if k == "text" else 1), hue) for k, v in n.items()}
    c["accent"] = _oklch(aL, chroma, hue)
    c["onAccent"] = _oklch(0.2, min(chroma, 0.06), hue) if aL > 0.68 else "#ffffff"
    c["accentText"] = _oklch(max(aL, 0.76) if dark else min(aL, 0.52), chroma, hue)
    c["success"] = _oklch(st, 0.15, 150)
    c["successSoft"] = _oklch(st, 0.15, 150, 0.2 if dark else 0.13)
    c["warning"] = _oklch(st, 0.16, 75)
    c["danger"] = _oklch(st, 0.2, 25)
    c["muted"] = "rgba(255,255,255,0.09)" if dark else "rgba(0,0,0,0.06)"
    c["stroke"] = "rgba(255,255,255,0.10)" if dark else "rgba(0,0,0,0.10)"
    return c


def build_css(dark):
    c = one_colors(dark)
    named = {
        "accent_bg_color": c["accent"], "accent_fg_color": c["onAccent"], "accent_color": c["accentText"],
        "destructive_bg_color": c["danger"], "destructive_color": c["danger"],
        "success_color": c["success"], "warning_color": c["warning"], "error_color": c["danger"],
        "window_bg_color": c["canvas"], "window_fg_color": c["text"],
        "view_bg_color": c["surface"], "view_fg_color": c["text"],
        "headerbar_bg_color": c["headerbar"], "headerbar_fg_color": c["text"],
        "headerbar_backdrop_color": c["headerbar"], "headerbar_shade_color": c["stroke"],
        "card_bg_color": c["surfaceAlt"] if dark else c["surface"], "card_fg_color": c["text"],
        "card_shade_color": c["stroke"],
        "dialog_bg_color": c["float"], "dialog_fg_color": c["text"],
        "popover_bg_color": c["float"], "popover_fg_color": c["text"],
    }
    if ADW_MINOR >= 6:
        colors = ":root {\n" + "".join(f"  --{k.replace('_', '-')}: {v};\n" for k, v in named.items()) + "}\n"
    else:
        colors = "".join(f"@define-color {k} {v};\n" for k, v in named.items())
    return colors + f"""
window, label, entry, text {{ font-family: "Inter", "Cantarell", sans-serif; }}
textview.log, textview.log text {{ font-family: "Geist Mono", monospace; font-size: 12px; }}
button, entry, dropdown > button {{ border-radius: 10px; }}
button.pill {{ border-radius: 999px; padding: 10px 28px; min-height: 20px; }}
.boxed-list, list.boxed-list, .card {{ border-radius: 14px; }}
.title-1 {{ font-weight: 750; letter-spacing: -0.005em; }}
.title-2 {{ font-weight: 750; letter-spacing: -0.005em; }}
.hero {{ min-width: 112px; min-height: 112px; border-radius: 999px; background: {c['muted']}; }}
.hero.on {{ background: {c['successSoft']}; color: {c['success']}; }}
.hero.on image {{ color: {c['success']}; }}
.hero image {{ color: alpha(currentColor, 0.55); }}
.status-line {{ font-size: 14px; }}
.warning-row image {{ color: {c['warning']}; }}
.logbox {{ border-radius: 14px; }}
"""


# ------------------------------------------------------------------ system queries

def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def zapret_installed():
    return os.path.isfile(os.path.join(ZAPRET_DIR, "install_easy.sh")) and \
        os.path.isfile(os.path.join(ZAPRET_DIR, "config"))


def bypass_running():
    return subprocess.run(["pgrep", "-x", "nfqws2"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def normalize_domain(raw):
    d = raw.strip().lower()
    if "://" in d:
        d = d.split("://", 1)[1]
    d = d.split("/", 1)[0].split("?", 1)[0].split("#", 1)[0].rsplit("@", 1)[-1]
    if ":" in d:
        d = d.split(":", 1)[0]
    d = d.strip(".")
    if "." not in d or " " in d or not d:
        return None
    try:
        d.encode("idna")
    except UnicodeError:
        return None
    return d


# ------------------------------------------------------------------ helper runner

class HelperRun:
    """Runs the root helper through pkexec and reports its events."""

    AUTH_FAILED = (126, 127)

    def __init__(self, args, on_event, on_log, on_exit):
        self.on_event, self.on_log, self.on_exit = on_event, on_log, on_exit
        self.cancellable = Gio.Cancellable()
        self.cancelled = False
        self.last_error = None
        self.done = None
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE |
                                              Gio.SubprocessFlags.STDERR_MERGE)
        self.proc = launcher.spawnv(["pkexec", HELPER] + args)
        self.stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._read()
        self.proc.wait_async(None, self._exited)

    def _read(self):
        self.stream.read_line_async(GLib.PRIORITY_DEFAULT, self.cancellable, self._line)

    def _line(self, stream, res):
        try:
            data, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            return
        if data is None:
            return
        if data.startswith("@{"):
            try:
                ev = json.loads(data[1:])
            except ValueError:
                ev = None
            if ev:
                if ev.get("event") == "error":
                    self.last_error = ev
                elif ev.get("event") == "done":
                    self.done = ev
                self.on_event(ev)
        else:
            self.on_log(data)
        self._read()

    def cancel(self):
        """Closing our end of the pipe makes the helper stop and clean up."""
        if self.cancelled:
            return
        self.cancelled = True
        self.cancellable.cancel()
        try:
            self.proc.get_stdout_pipe().close(None)
        except GLib.Error:
            pass

    def _exited(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        status = proc.get_exit_status() if proc.get_if_exited() else -1
        GLib.idle_add(self.on_exit, self, status)


# ------------------------------------------------------------------ UI helpers

def label(text="", classes=(), wrap=True, xalign=0.5, selectable=False):
    lb = Gtk.Label(label=text, wrap=wrap, xalign=xalign, justify=Gtk.Justification.CENTER
                   if xalign == 0.5 else Gtk.Justification.LEFT, selectable=selectable)
    lb.set_wrap_mode(2)  # Pango.WrapMode.WORD_CHAR
    for c in classes:
        lb.add_css_class(c)
    return lb


def pill(text, suggested=True):
    b = Gtk.Button(label=text, halign=Gtk.Align.CENTER)
    b.add_css_class("pill")
    if suggested:
        b.add_css_class("suggested-action")
    return b


def page_box():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, valign=Gtk.Align.CENTER,
                  margin_top=24, margin_bottom=32, margin_start=32, margin_end=32)
    clamp = Adw.Clamp(maximum_size=420, child=box)
    scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp,
                                  propagate_natural_height=True)
    return scroller, box


def app_icon():
    img = Gtk.Image(icon_name="zapret2-gui", pixel_size=96, halign=Gtk.Align.CENTER)
    img.set_margin_bottom(12)
    return img


def hero(icon_name, pixel_size=56):
    frame = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.add_css_class("hero")
    img = Gtk.Image(icon_name=icon_name, pixel_size=pixel_size, hexpand=True, vexpand=True,
                    halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.append(img)
    frame.set_margin_bottom(12)
    return frame, img


def make_spinner():
    if hasattr(Adw, "Spinner"):
        sp = Adw.Spinner()
        sp.set_size_request(56, 56)
        return sp
    sp = Gtk.Spinner(spinning=True)
    sp.set_size_request(56, 56)
    return sp


def fmt_elapsed(sec):
    return f"{sec // 60}:{sec % 60:02d}"


def fmt_date(ts):
    try:
        return time.strftime("%b %-d, %Y", time.localtime(int(ts)))
    except (TypeError, ValueError):
        return ""


