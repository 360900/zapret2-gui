    if ADW_MINOR >= 6:
        colors = ":root {\n" + "".join(f"  --{k.replace('_', '-')}: {v};\n" for k, v in named.items()) + "}\n"
    else:
        colors = "".join(f"@define-color {k} {v};\n" for k, v in named.items())
    return colors + f"""
window, label, entry, text {{ font-family: "Inter", "Cantarell", sans-serif; }}
textview.log, textview.log text {{ font-family: "Geist Mono", monospace; font-size: 12px; }}
button, entry, dropdown > button {{ border-radius: 10px; }}
button.pill {{ border-radius: 999px; padding: 10px 28px; min-height: 20px; }}
