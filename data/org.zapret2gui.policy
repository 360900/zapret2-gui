<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Zapret2 GUI</vendor>
  <action id="org.zapret2gui.helper">
    <description>Change website unblocking settings</description>
    <message>Authentication is required to change website unblocking settings</message>
    <icon_name>zapret2-gui</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/zapret2-gui/zapret2-gui-helper</annotate>
  </action>
</policyconfig>
