    def refresh(self):
        """Pick the page that fits the current system state."""
        if self.run:
            self.stack.set_visible_child_name("working")
            return
        if not zapret_installed():
            self.stack.set_visible_child_name("missing")
            return
        st = load_state()
        if not st.get("strategy"):
            self.show_welcome(first=True)
            return
        on = bypass_running()
        self.switch_guard = True
        self.switch.set_active(on)
        self.switch_guard = False
        if on:
            self.home_hero.add_css_class("on")
            self.home_icon.set_from_icon_name("security-high-symbolic")
            self.home_title.set_label("Unblocking is on")
            self.home_sub.set_label("Blocked websites and apps should work normally now.")
        else:
            self.home_hero.remove_css_class("on")
            self.home_icon.set_from_icon_name("security-low-symbolic")
            self.home_title.set_label("Unblocking is off")
            self.home_sub.set_label("Turn it on to use blocked websites and apps.")
        doms = st.get("domains") or ([st["domain"]] if st.get("domain") else [])
        when = fmt_date(st.get("updated"))
        info = f"Method found on {when}, tested with {', '.join(doms)}." if doms and when else ""
        if st.get("failing"):
            info += f" Still not opening in the last check: {', '.join(st['failing'])}."
        self.home_info.set_label(info.strip())
        self.dns_list.set_visible(bool(st.get("dns_spoofed")))
        self.stack.set_visible_child_name("home")

    def show_welcome(self, first=False):
        st = load_state()
        if not any(e.get_text().strip() for e in self.entries):
            self.set_domains(st.get("domains") or ([st["domain"]] if st.get("domain") else []))
        self.welcome_back.set_visible(not first and bool(st.get("strategy")))
        self.entry_hint.set_visible(False)
        self._update_start()
        self.stack.set_visible_child_name("welcome")
        self.entry.grab_focus()

    def _update_start(self):
        if hasattr(self, "start_btn"):
            self.start_btn.set_sensitive(any(e.get_text().strip() for e in self.entries))

    def show_error(self, title, message, action="welcome", icon="dialog-warning-symbolic"):
        self.err_title.set_label(title)
        self.err_msg.set_label(message)
        self.err_icon.set_from_icon_name(icon)
        self.err_action = action
        self.err_btn.set_label({"welcome": "Change websites", "install": "Try again",
                                "retry": "Try again"}.get(action, "Try again"))
        self.err_back.set_visible(zapret_installed() and bool(load_state().get("strategy")))
        self.stack.set_visible_child_name("error")

    def _err_action(self):
        if self.err_action == "install":
            self.start_install()
        elif self.err_action == "update":
            self.on_update()
        elif self.err_action == "retry" and any(e.get_text().strip() for e in self.entries):
            self.start_blockcheck()
        else:
            self.show_welcome()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def notify(self, text):
        """Desktop notification, only when the window is not visible."""
        if self.get_visible():
            return
        n = Gio.Notification.new(APP_NAME)
        n.set_body(text)
        n.set_icon(Gio.ThemedIcon.new("zapret2-gui"))
        n.set_default_action("app.show")
        self.get_application().send_notification("result", n)

    # ---------------------------------------------------------- tasks

    def _begin(self, task, args, title):
        self.task = task
        self.tested = 0
        self.authed = False
        self.started = time.monotonic()
        self.log_buf.set_text("")
        self.work_title.set_label(title)
        self.work_sub.set_label("Waiting for your password…")
        self.cancel_btn.set_sensitive(True)
        self.cancel_btn.set_label("Cancel")
        self.cancel_btn.set_visible(task != "toggle")
        self.work_note.set_visible(task in ("install", "update", "blockcheck"))
        self.menu_button.set_sensitive(False)
        self.stack.set_visible_child_name("working")
        try:
            self.run = HelperRun(args, self.on_event, self.on_log, self.on_exit)
        except GLib.Error as e:
            self.run = None
            self.menu_button.set_sensitive(True)
            self.show_error("Could not start", f"pkexec is required but could not be started ({e.message}).",
                            action="install" if task == "install" else "welcome")
            return
        self.timer = GLib.timeout_add_seconds(1, self._tick)
        self.get_application().update_status()

    def _tick(self):
        if not self.run:
            self.timer = None
            return False
        if self.authed:
            self._update_progress()
        return True

    def _update_progress(self):
        el = fmt_elapsed(int(time.monotonic() - self.started))
        if self.task == "blockcheck" and self.tested:
            n = self.tested
            self.work_sub.set_label(f"Tried {n} method{'s' if n != 1 else ''} · {el}")
        else:
            self.work_sub.set_label(el)

    def start_install(self):
        if self.run:
            return
        self._begin("install", ["install"], "Setting up")

    def start_blockcheck(self):
        if self.run:
            return
        doms = []
        for row in list(self.entries):
            text = row.get_text().strip()
            if not text:
                continue
            dom = normalize_domain(text)
            if not dom:
                self.entry_hint.set_label(f"\"{text}\" is not a website address. Use something like example.com")
                self.entry_hint.set_visible(True)
                row.grab_focus()
                return
            row.set_text(dom)
            if dom not in doms:
                doms.append(dom)
        if not doms:
            return
        self.entry_hint.set_visible(False)
        self._begin("blockcheck", ["blockcheck"] + doms, "Looking for a working method")

    def on_switch(self, sw, _p):
        if self.switch_guard or self.run:
            return
        on = sw.get_active()
        self._begin("toggle", ["enable" if on else "disable"],
                    "Turning unblocking on" if on else "Turning unblocking off")

    def cancel_task(self):
        if self.run and not self.run.cancelled:
            self.cancel_btn.set_sensitive(False)
            self.cancel_btn.set_label("Stopping…")
            self.work_title.set_label("Stopping and restoring settings")
            self.run.cancel()

    def on_event(self, ev):
        self._authed()
        kind = ev.get("event")
        if kind == "step":
            if self.run and not self.run.cancelled:
                self.work_title.set_label(ev.get("text", ""))
            self._update_progress()
        elif kind == "progress":
            self.tested = int(ev.get("tested", 0))
            self._update_progress()

    def _authed(self):
        if not self.authed:
            # Output means pkexec accepted the password; restart the clock.
            self.authed = True
            self.started = time.monotonic()
            self._update_progress()

    def on_log(self, line):
        self._authed()
        end = self.log_buf.get_end_iter()
        self.log_buf.insert(end, line + "\n")
        # Keep the log bounded.
        if self.log_buf.get_line_count() > 4000:
            start = self.log_buf.get_start_iter()
            cut = self.log_buf.get_iter_at_line(1000)
            cut = cut[1] if isinstance(cut, tuple) else cut
            self.log_buf.delete(start, cut)
        adj = self.log_scroll.get_vadjustment()
        if adj.get_value() + adj.get_page_size() >= adj.get_upper() - 40:
            GLib.idle_add(lambda: adj.set_value(adj.get_upper()) and False)

    def on_exit(self, run, status):
        task = self.task
        self.run = None
        self.task = None
        GLib.idle_add(lambda: self.get_application().update_status() and False)
        self.menu_button.set_sensitive(True)
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        err = run.last_error

        if status in HelperRun.AUTH_FAILED and not run.done and not err:
            self.toast("Password was not entered")
            self.refresh()
            return
        if run.cancelled:
            self.toast("Stopped. Your previous settings were kept.")
            self.refresh()
            return
        if status == 0 and run.done:
            if task == "install":
                self.toast("Setup complete")
                self.show_welcome(first=True)
            elif task == "update":
                self.toast(run.done.get("message", "Done"))
                self.refresh()
            elif task == "blockcheck":
                failing, total = run.done.get("failing") or [], len(run.done.get("domains") or [])
                if failing:
                    msg = f"Done. Works for {total - len(failing)} of {total} websites"
                else:
                    msg = "Done! Blocked websites and apps should work now"
                self.toast(msg)
                self.notify(msg)
                self.refresh()
            else:
                self.refresh()
            return

        code = (err or {}).get("code", "")
        msg = (err or {}).get("message") or "Something went wrong. Open Details for more information."
        if task in ("install", "update"):
            self.show_error("Setup failed" if task == "install" else "Update failed", msg, action=task)
        elif task == "blockcheck":
            titles = {"unblocked": ("Nothing to unblock", "welcome", "dialog-information-symbolic"),
                      "notfound": ("No working method found", "welcome", "dialog-warning-symbolic"),
                      "resolve": ("Website not found", "welcome", "dialog-warning-symbolic"),
                      "unreachable": ("Could not test", "welcome", "dialog-warning-symbolic"),
                      "domain": ("Check the address", "welcome", "dialog-warning-symbolic"),
                      "missing": ("Setup needed", "install", "dialog-warning-symbolic"),
                      "busy": ("Already running", "retry", "dialog-warning-symbolic")}
            title, action, icon = titles.get(code, ("Something went wrong", "retry", "dialog-warning-symbolic"))
            self.show_error(title, msg, action=action, icon=icon)
            self.notify(title)
        else:
            self.toast(msg)
            self.refresh()

    # ---------------------------------------------------------- menu & close

    def on_update(self):
        if self.run:
            return
        self._begin("update", ["update"], "Checking for zapret2 updates")

    def on_about(self):
        if hasattr(Adw, "AboutDialog"):
            d = Adw.AboutDialog()
        else:
            d = Adw.AboutWindow(transient_for=self)
        d.set_application_name(APP_NAME)
        d.set_application_icon("zapret2-gui")
        d.set_version(VERSION)
        d.set_comments("One-click DPI bypass for blocked websites, powered by zapret2.")
        d.set_website("https://github.com/bol-van/zapret2")
        d.set_license_type(Gtk.License.GPL_3_0)
        d.present(self) if hasattr(Adw, "AboutDialog") else d.present()

    def _confirm(self, heading, body, ok, callback):
        if hasattr(Adw, "AlertDialog"):
            d = Adw.AlertDialog(heading=heading, body=body)
        else:
            d = Adw.MessageDialog(transient_for=self, heading=heading, body=body)
        d.add_response("cancel", "Cancel")
        d.add_response("ok", ok)
        d.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE
                                  if ok == "Stop" else Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("cancel")
        d.set_close_response("cancel")
        d.connect("response", lambda _d, r: callback() if r == "ok" else None)
        d.present(self) if hasattr(Adw, "AlertDialog") else d.present()

    def on_close_request(self, _w):
        app = self.get_application()
        if app.tray.available:
            # Keep running in the tray; a running task continues in the background.
            self.set_visible(False)
            app.hint_tray()
            return True
        if self.busy():
            self.confirm_quit()
            return True
        return False

    def busy(self):
        return bool(self.run and self.task in ("install", "update", "blockcheck") and not self.run.cancelled)

    def confirm_quit(self):
        def stop_and_quit():
            if self.run:
                self.run.cancel()
            self._close_when_idle()
        self._confirm("Stop and quit?",
                      "The current task will be stopped and your previous settings kept.",
                      "Stop", stop_and_quit)

    def _close_when_idle(self):
        def check():
            if self.run:
                return True
            self.get_application().quit()
            return False
        GLib.timeout_add(200, check)


class App(Adw.Application):
    def __init__(self, background=False):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS
                         if hasattr(Gio.ApplicationFlags, "DEFAULT_FLAGS") else Gio.ApplicationFlags.FLAGS_NONE)
        self.css = None
        self.win = None
        self.tray = None
        self.background = background
        self.last_status = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        GLib.set_application_name(APP_NAME)
        Gtk.Window.set_default_icon_name("zapret2-gui")
        sm = Adw.StyleManager.get_default()
        sm.connect("notify::dark", lambda *_a: self._load_css())
        self._load_css()
        for name, fn in (("show", self.show_window), ("quit", self.request_quit)):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", lambda *_a, f=fn: f())
            self.add_action(act)
        self.tray = Tray(self.toggle_window, self._tray_changed)
        self.update_status()
        GLib.timeout_add_seconds(5, lambda: self.update_status() or True)

    def _load_css(self):
        disp = Gdk.Display.get_default()
        if self.css:
            Gtk.StyleContext.remove_provider_for_display(disp, self.css)
        self.css = Gtk.CssProvider()
        css = build_css(Adw.StyleManager.get_default().get_dark())
        try:
            self.css.load_from_string(css)
        except AttributeError:
            self.css.load_from_data(css, -1)
        Gtk.StyleContext.add_provider_for_display(disp, self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        first = self.win is None
        if first:
            self.win = Window(self)
        if first and self.background:
            # Started at login: stay in the tray. Without a tray there is nothing
            # to show, and the bypass runs as a system service anyway, so quit.
            GLib.timeout_add_seconds(30, self._background_check)
            return
        self.show_window()

    def _background_check(self):
        if not self.tray.available and not self.win.get_visible():
            self.quit()
        return False

    def _tray_changed(self, available):
        if not available and self.win and not self.win.get_visible():
            # Tray went away while hidden: show the window so the app is reachable.
            self.show_window()

    # ---- window and tray actions

    def show_window(self, welcome=False):
        if not self.win:
            self.win = Window(self)
        if welcome and not self.win.run:
            self.win.show_welcome()
        elif not self.win.run:
            self.win.refresh()
        self.win.present()

    def toggle_window(self):
        if self.win and self.win.get_visible():
            self.win.set_visible(False)
        else:
            self.show_window()

    def request_quit(self):
        if self.win and self.win.busy():
            self.show_window()
            self.win.confirm_quit()
            return
        self.quit()

    def toggle_unblocking(self):
        if self.win and not self.win.run:
            self.win.switch.set_active(not bypass_running())

    def hint_tray(self):
        """Tell the user once that closing keeps Zapret2 in the tray."""
        flag = os.path.join(CONFIG_DIR, "tray-hint-shown")
        if os.path.exists(flag):
            return
        n = Gio.Notification.new(APP_NAME)
        n.set_body("Zapret2 keeps running in the tray. Right-click the tray icon to quit.")
        n.set_icon(Gio.ThemedIcon.new("zapret2-gui"))
        self.send_notification("tray-hint", n)
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            open(flag, "w").close()
        except OSError:
            pass

    def update_status(self):
        """Refresh tray icon, tooltip and menu from the system state."""
        installed = zapret_installed()
        st = load_state()
        configured = installed and bool(st.get("strategy"))
        on = configured and bypass_running()
        busy = bool(self.win and self.win.run)
        status = (installed, configured, on, busy, busy and self.win.work_title.get_label())
        if status == self.last_status:
            return
        self.last_status = status
        if busy:
            tip = self.win.work_title.get_label() or "Working…"
        elif not installed:
            tip = "Setup needed"
        elif not configured:
            tip = "No method found yet"
        else:
            tip = "Unblocking is on" if on else "Unblocking is off"
        self.tray.set_state("zapret2-gui" if on or busy else "zapret2-gui-off", tip)
        self.tray.set_menu([
            {"id": 1, "label": "Open Zapret2", "callback": self.show_window},
            {"id": 2, "label": "Unblocking", "toggle": on, "enabled": configured and not busy,
             "callback": self.toggle_unblocking},
            {"id": 3, "label": "Find a new method…", "enabled": installed and not busy,
             "callback": lambda: self.show_window(welcome=True)},
            {"id": 4, "separator": True},
            {"id": 5, "label": "Quit", "callback": self.request_quit},
        ])
        if self.win and self.win.get_visible() and not busy and \
                self.win.stack.get_visible_child_name() == "home":
            self.win.refresh()


def main():
    if not shutil.which("pkexec"):
        print("pkexec (polkit) is required", file=sys.stderr)
    args = [a for a in sys.argv if a != "--background"]
    return App(background=len(args) != len(sys.argv)).run(args)


if __name__ == "__main__":
    sys.exit(main())
