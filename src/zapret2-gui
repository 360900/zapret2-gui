def bypass_running():
    return subprocess.run(["pgrep", "-x", "nfqws2"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def normalize_domain(raw):
    d = raw.strip().lower()
    if "://" in d:
        d = d.split("://", 1)[1]
    d = d.split("/", 1)[0].split("?", 1)[0].split("#", 1)[0].rsplit("@", 1)[-1]
    if ":" in d:
        d = d.split(":", 1)[0]
    d = d.strip(".")
    if "." not in d or " " in d or not d:
        return None
    try:
        d.encode("idna")
    except UnicodeError:
        return None
    return d


# ------------------------------------------------------------------ helper runner

class HelperRun:
    """Runs the root helper through pkexec and reports its events."""

    AUTH_FAILED = (126, 127)

    def __init__(self, args, on_event, on_log, on_exit):
        self.on_event, self.on_log, self.on_exit = on_event, on_log, on_exit
        self.cancellable = Gio.Cancellable()
        self.cancelled = False
        self.last_error = None
        self.done = None
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE |
                                              Gio.SubprocessFlags.STDERR_MERGE)
        self.proc = launcher.spawnv(["pkexec", HELPER] + args)
        self.stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._read()
        self.proc.wait_async(None, self._exited)

    def _read(self):
        self.stream.read_line_async(GLib.PRIORITY_DEFAULT, self.cancellable, self._line)

    def _line(self, stream, res):
        try:
            data, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            return
        if data is None:
            return
        if data.startswith("@{"):
            try:
                ev = json.loads(data[1:])
            except ValueError:
                ev = None
            if ev:
                if ev.get("event") == "error":
                    self.last_error = ev
                elif ev.get("event") == "done":
                    self.done = ev
                self.on_event(ev)
        else:
            self.on_log(data)
        self._read()

    def cancel(self):
        """Closing our end of the pipe makes the helper stop and clean up."""
        if self.cancelled:
            return
        self.cancelled = True
        self.cancellable.cancel()
        try:
            self.proc.get_stdout_pipe().close(None)
        except GLib.Error:
            pass

    def _exited(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        status = proc.get_exit_status() if proc.get_if_exited() else -1
        GLib.idle_add(self.on_exit, self, status)


