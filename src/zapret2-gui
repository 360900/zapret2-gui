# ------------------------------------------------------------------ oneDesign colors
# Mirrors oneDesign tokens/one.json + tools/onetokens.py (blue accent).

def _oklch(L, C, H, a=1.0):
    h = math.radians(H)
    A, B = C * math.cos(h), C * math.sin(h)
    l_ = L + 0.3963377774 * A + 0.2158037573 * B
    m_ = L - 0.1055613458 * A - 0.0638541728 * B
    s_ = L - 0.0894841775 * A - 1.2914855480 * B
    l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
    lin = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
           -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
           -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)

    def g(x):
        x = min(max(x, 0.0), 1.0)
        return 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055

    r, gg, b = (round(g(v) * 255) for v in lin)
    return f"#{r:02x}{gg:02x}{b:02x}" if a >= 1 else f"rgba({r},{gg},{b},{a:.3f})"


def one_colors(dark):
    hue, chroma, nc = 255, 0.16, 0.006
    n = ({"canvas": 0.215, "surface": 0.25, "surfaceAlt": 0.285, "float": 0.28, "headerbar": 0.215, "text": 0.96}
         if dark else
         {"canvas": 0.975, "surface": 1.0, "surfaceAlt": 0.965, "float": 0.99, "headerbar": 0.975, "text": 0.2})
    aL = 0.74 if dark else 0.56
    st = 0.74 if dark else 0.56
    c = {k: _oklch(v, nc * (2 if k == "text" else 1), hue) for k, v in n.items()}
    c["accent"] = _oklch(aL, chroma, hue)
    c["onAccent"] = _oklch(0.2, min(chroma, 0.06), hue) if aL > 0.68 else "#ffffff"
    c["accentText"] = _oklch(max(aL, 0.76) if dark else min(aL, 0.52), chroma, hue)
    c["success"] = _oklch(st, 0.15, 150)
    c["successSoft"] = _oklch(st, 0.15, 150, 0.2 if dark else 0.13)
    c["warning"] = _oklch(st, 0.16, 75)
    c["danger"] = _oklch(st, 0.2, 25)
    c["muted"] = "rgba(255,255,255,0.09)" if dark else "rgba(0,0,0,0.06)"
    c["stroke"] = "rgba(255,255,255,0.10)" if dark else "rgba(0,0,0,0.10)"
    return c


def build_css(dark):
    c = one_colors(dark)
    named = {
        "accent_bg_color": c["accent"], "accent_fg_color": c["onAccent"], "accent_color": c["accentText"],
        "destructive_bg_color": c["danger"], "destructive_color": c["danger"],
        "success_color": c["success"], "warning_color": c["warning"], "error_color": c["danger"],
        "window_bg_color": c["canvas"], "window_fg_color": c["text"],
        "view_bg_color": c["surface"], "view_fg_color": c["text"],
        "headerbar_bg_color": c["headerbar"], "headerbar_fg_color": c["text"],
        "headerbar_backdrop_color": c["headerbar"], "headerbar_shade_color": c["stroke"],
        "card_bg_color": c["surfaceAlt"] if dark else c["surface"], "card_fg_color": c["text"],
        "card_shade_color": c["stroke"],
        "dialog_bg_color": c["float"], "dialog_fg_color": c["text"],
        "popover_bg_color": c["float"], "popover_fg_color": c["text"],
