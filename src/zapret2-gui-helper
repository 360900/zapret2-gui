"""Privileged helper for Zapret2 GUI.

Runs as root (through pkexec from the GUI, or sudo from install.sh/uninstall.sh).
Drives zapret2's own scripts non-interactively:

  install            download the latest zapret2 release and run install_easy.sh
                     with every answer preset for this system
  blockcheck DOMAIN...
                     run blockcheck2.sh in batch mode, turn the result into a
                     zapret2 profile, apply it and verify it on every domain
  update             update zapret2 to the latest release, keeping the config and
                     the method found (installs if zapret2 is missing)
  enable | disable   turn bypass on or off (also at boot)
  uninstall          remove zapret2 completely

Output: human readable log lines, plus machine events as lines starting with
"@" followed by JSON. --plain hides the events (for terminals).
"""

import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from concurrent.futures import ThreadPoolExecutor

ZAPRET_DIR = "/opt/zapret2"
CONFIG = ZAPRET_DIR + "/config"
CONFIG_DEFAULT = ZAPRET_DIR + "/config.default"
USER_HOSTLIST = ZAPRET_DIR + "/ipset/zapret-hosts-user.txt"
STATE_DIR = "/var/lib/zapret2-gui"
STATE_FILE = STATE_DIR + "/state.json"
LOCK_FILE = "/run/zapret2-gui.lock"
RELEASES = "https://github.com/bol-van/zapret2/releases"
UA = "zapret2-gui"

# Fallbacks if config.default ever stops shipping these lines.
DEFAULT_HTTP = "--payload=http_req --lua-desync=fake:blob=fake_default_http:tcp_md5 --lua-desync=multisplit:pos=method+2"
DEFAULT_TLS = "--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:tcp_seq=-10000 --lua-desync=multidisorder:pos=1,midsld"
DEFAULT_QUIC = "--payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6"

# Characters a blockcheck strategy may contain. Anything else is rejected
# before it gets near a shell-sourced config file.
SAFE_STRATEGY = re.compile(r"^[A-Za-z0-9_=:,.<>@/+\-~ ]+$")
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$")

PLAIN = False
os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
os.environ.setdefault("LANG", "C.UTF-8")


class Fail(Exception):
    """Expected failure with a code the GUI understands."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


class Aborted(Exception):
    """The GUI went away (closed pipe) or we got a termination signal."""


# ---------------------------------------------------------------- output

def out(line):
    try:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        raise Aborted()


def log(text):
    out(text)


def event(kind, **data):
    if PLAIN:
        if kind == "step":
            out("==> " + data.get("text", data.get("id", "")))
        elif kind in ("done", "error"):
            out(("Done: " if kind == "done" else "Error: ") + data.get("message", ""))
        return
    data["event"] = kind
    out("@" + json.dumps(data, ensure_ascii=False))


def _on_signal(signum, frame):
    raise Aborted()


# ---------------------------------------------------------------- state

def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE_FILE)


# ---------------------------------------------------------------- system

def run(cmd, check=False, **kw):
    return subprocess.run(cmd, stdin=subprocess.DEVNULL, check=check, **kw)


def has_systemd():
    return os.path.isdir("/run/systemd/system") and shutil.which("systemctl")


def stream(cmd, env=None, timeout=None, on_line=None, cwd=None):
    """Run cmd, forwarding its output line by line. Returns (exit code, lines)."""
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, env=env, cwd=cwd,
                            start_new_session=True, text=True, errors="replace", bufsize=1)
    lines = []
    deadline = time.monotonic() + timeout if timeout else None
    try:
        for raw in proc.stdout:
            line = raw.rstrip("\n")
            lines.append(line)
            log(line)
            if on_line:
                on_line(line)
            if deadline and time.monotonic() > deadline:
                raise Fail("timeout", "The operation took too long and was stopped.")
        proc.wait()
    except BaseException:
        # SIGTERM lets blockcheck2.sh run its own cleanup trap (removes its
        # firewall rules and kills its nfqws2 instance).
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
        raise
    return proc.returncode, lines


def zapret_installed():
    return os.path.isfile(ZAPRET_DIR + "/install_easy.sh") and os.path.isfile(CONFIG)


def service_installed():
    if has_systemd():
        return any(os.path.isfile(d + "/zapret2.service")
                   for d in ("/etc/systemd/system", "/lib/systemd/system", "/usr/lib/systemd/system"))
    return os.path.exists("/etc/init.d/zapret2")


def service(action):
    """action: start, stop, enable, disable. Returns True on success."""
    if has_systemd():
        return run(["systemctl", action, "zapret2"], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL).returncode == 0
    init = "/etc/init.d/zapret2"
    if not os.path.exists(init):
        return False
    if action in ("enable", "disable"):
        if shutil.which("rc-update"):
            verb = "add" if action == "enable" else "del"
            return run(["rc-update", verb, "zapret2"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL).returncode == 0
        return run([init, action], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    return run([init, action], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def nfqws_running():
    return run(["pgrep", "-x", "nfqws2"], stdout=subprocess.DEVNULL).returncode == 0


def wait_nfqws():
    for _ in range(10):
        if nfqws_running():
            return True
        time.sleep(0.3)
    return False


def service_restart_checked():
    service("stop")
    if has_systemd():
        run(["systemctl", "reset-failed", "zapret2"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return service("start") and wait_nfqws()


INIT_SCRIPT = ZAPRET_DIR + "/init.d/sysv/zapret2"


def trial_start():
    """Start zapret2 with the current config for a quick test.

    Uses zapret2's init script directly (what the systemd unit runs), so trying
    several methods in a row doesn't hit systemd's start rate limit.
    """
    trial_stop()
    if run([INIT_SCRIPT, "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        trial_stop()
        return False
    return wait_nfqws()


def trial_stop():
    run([INIT_SCRIPT, "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ipv6_works():
    for host in ("2606:4700:4700::1111", "2001:4860:4860::8888"):
        try:
            with socket.create_connection((host, 443), timeout=3):
                return True
        except OSError:
            continue
    return False


# ---------------------------------------------------------------- config

def read_config():
    with open(CONFIG) as f:
        return f.read()


def write_config(text):
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CONFIG)


def set_var(text, name, value):
    """Set NAME=value in a zapret config, uncommenting it if needed."""
    line = f"{name}={value}"
    pat = re.compile(rf"^[ \t]*#?[ \t]*{name}=(\"[^\"]*\"|[^\n]*)$", re.M)
    if pat.search(text):
        return pat.sub(lambda m: line, text, count=1)
    return text.rstrip("\n") + "\n" + line + "\n"


def get_var(text, name):
    m = re.search(rf"^[ \t]*{name}=(\"([^\"]*)\"|([^\n]*))$", text, re.M)
    if not m:
        return None
    return m.group(2) if m.group(2) is not None else m.group(3).strip()


def default_strategies():
    """HTTP and QUIC strategies from zapret2's own config.default."""
    http, quic = DEFAULT_HTTP, DEFAULT_QUIC
    try:
        with open(CONFIG_DEFAULT) as f:
            opt = get_var(f.read(), "NFQWS2_OPT") or ""
    except OSError:
        opt = ""
    for line in opt.splitlines():
        body = re.sub(r"\s*--new\s*$", "", line.strip())
        m = re.search(r"<HOSTLIST(?:_NOAUTO)?>\s+(.+)$", body)
        if not m:
            continue
        if "--filter-tcp=80 " in body and "--filter-l7=http " in body:
            http = m.group(1)
        elif "--filter-udp=443 " in body and "--filter-l7=quic " in body:
            quic = m.group(1)
    return http, quic


def ipv6_variant(strategy):
    """blockcheck tests over IPv4, so TTL foolings come out as ip_ttl/ip_autottl.
    Those only touch IPv4 packets; add the IPv6 equivalents next to them."""
    return re.sub(r"(?<![0-9A-Za-z_])ip_(ttl|autottl)=([^:\s]+)",
                  lambda m: f"ip_{m.group(1)}={m.group(2)}:ip6_{m.group(1)}={m.group(2)}", strategy)


def build_opt(tls_strategy, ipv6):
    http, quic = default_strategies()
    tls = ipv6_variant(tls_strategy) if ipv6 else tls_strategy
    return ("\n"
            f"--filter-tcp=80 --filter-l7=http <HOSTLIST> {http} --new\n"
            f"--filter-tcp=443 --filter-l7=tls <HOSTLIST> {tls} --new\n"
            f"--filter-udp=443 --filter-l7=quic <HOSTLIST_NOAUTO> {quic}\n")


def apply_profile(tls_strategy):
    text = read_config()
    ipv6 = get_var(text, "DISABLE_IPV6") != "1"
    text = set_var(text, "NFQWS2_ENABLE", "1")
    text = set_var(text, "MODE_FILTER", "autohostlist")
    text = set_var(text, "NFQWS2_OPT", '"' + build_opt(tls_strategy, ipv6) + '"')
    write_config(text)


def add_user_domains(domains):
    try:
        with open(USER_HOSTLIST) as f:
            entries = [l.strip() for l in f if l.strip()]
    except OSError:
        entries = []
    entries = [e for e in entries if e != "nonexistent.domain"]
    entries += [d for d in domains if d not in entries]
    with open(USER_HOSTLIST, "w") as f:
        f.write("\n".join(entries) + "\n")


# ---------------------------------------------------------------- locking

def take_lock():
    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Fail("busy", "Another Zapret2 task is already running.")
    return fd


# ---------------------------------------------------------------- install

def fetch(url, dest=None):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=60) as r:
        if dest is None:
            return r.geturl(), r.read()
        with open(dest, "wb") as f:
            shutil.copyfileobj(r, f)
        return r.geturl(), None


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_sums(src, sums):
    """The release's sha256sum.txt lists every prebuilt binary. Check them all."""
    checked = 0
    for line in sums.splitlines():
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        digest, rel = parts[0].lower(), parts[1].strip().lstrip("*")
        if ".." in rel.split("/") or rel.startswith("/"):
            continue
        path = os.path.join(src, rel)
        if not os.path.isfile(path) or sha256_file(path) != digest:
            raise Fail("checksum", "The downloaded zapret2 archive is damaged. Please try again.")
        checked += 1
    if not checked:
        raise Fail("checksum", "Could not verify the downloaded zapret2 archive.")
    log(f"verified {checked} files")


def latest_tag():
    try:
        final, _ = fetch(RELEASES + "/latest")
    except OSError as e:
        raise Fail("network", f"Could not reach GitHub to download zapret2 ({e}).")
    tag = final.rstrip("/").rsplit("/", 1)[-1]
    if not re.fullmatch(r"v[0-9][0-9A-Za-z.\-]*", tag):
        raise Fail("network", "Could not find the latest zapret2 release.")
    return tag


def download_release(workdir, tag):
    event("step", id="download", text="Downloading zapret2 " + tag)
    name = f"zapret2-{tag}.tar.gz"
    tarball = os.path.join(workdir, name)
    log(f"latest release: {tag}")
    try:
        _, sums = fetch(f"{RELEASES}/download/{tag}/sha256sum.txt")
        fetch(f"{RELEASES}/download/{tag}/{name}", tarball)
    except OSError as e:
        raise Fail("network", f"Downloading zapret2 failed ({e}).")
    log("downloaded")

    src = os.path.join(workdir, "src")
    os.mkdir(src)
    with tarfile.open(tarball) as t:
        if hasattr(tarfile, "data_filter"):
            t.extractall(src, filter="data")
        else:
            for m in t.getmembers():
                if m.name.startswith("/") or ".." in m.name.split("/"):
                    raise Fail("checksum", "Unexpected file in zapret2 archive.")
            t.extractall(src)
    verify_sums(src, sums.decode(errors="replace"))
    tops = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]
    if len(tops) != 1 or not os.path.isfile(os.path.join(src, tops[0], "install_easy.sh")):
        raise Fail("checksum", "Unexpected zapret2 archive layout.")
    return os.path.join(src, tops[0])


def remove_existing():
    """Stop and remove an existing /opt/zapret2 the way its own uninstaller does."""
    if not os.path.isdir(ZAPRET_DIR):
        return
    log("removing previous zapret2 installation")
    if os.path.isfile(CONFIG):
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        shutil.copy2(CONFIG, STATE_DIR + "/config.before-gui")
    if os.path.isfile(ZAPRET_DIR + "/uninstall_easy.sh"):
        stream(["sh", ZAPRET_DIR + "/uninstall_easy.sh"], timeout=180)
    shutil.rmtree(ZAPRET_DIR)


def preset_config(src):
    """Write the answers install_easy.sh would ask for into config.

    install_easy.sh uses the current config values as the default answer to
    every question, so with these preset and stdin closed it takes exactly
    these choices. FWTYPE is left unset so zapret2 detects nftables/iptables
    itself, same as pressing Enter at that prompt.
    """
    with open(os.path.join(src, "config.default")) as f:
        text = f.read()
    ipv6 = ipv6_works()
    log(f"ipv6 connectivity: {'yes' if ipv6 else 'no'}")
    for name, value in (
        ("NFQWS2_ENABLE", "1"),
        ("MODE_FILTER", "autohostlist"),
        ("FLOWOFFLOAD", "none"),
        ("DISABLE_IPV6", "0" if ipv6 else "1"),
        ("GETLIST", ""),
        ("INIT_APPLY_FW", "1"),
    ):
        text = set_var(text, name, value)
    return text


def run_install_easy():
    """Run install_easy.sh with stdin closed: every question takes the value
    already in config as its answer."""
    event("step", id="configure", text="Configuring zapret2 for this system")
    env = dict(os.environ, EDITOR="true", VISUAL="true", TERM="dumb")
    code, lines = stream(["sh", ZAPRET_DIR + "/install_easy.sh"], env=env, timeout=1200, cwd=ZAPRET_DIR)
    text = "\n".join(lines)
    if code != 0:
        if "not either systemd, openrc or openwrt" in text:
            raise Fail("unsupported", "Your system's service manager is not supported. "
                                      "zapret2 needs systemd or OpenRC to start automatically.")
        if "could not install prerequisites" in text or "supported package manager not found" in text:
            raise Fail("prereq", "Required system packages could not be installed.")
        if "build tools not found" in text or "could not compile" in text:
            raise Fail("arch", "zapret2 has no ready-made program for this processor.")
        raise Fail("install", f"zapret2 installer failed (code {code}).")
    if not service_installed():
        raise Fail("install", "zapret2 was installed but its service is missing.")


def place_tree(src):
    shutil.copytree(src, ZAPRET_DIR, symlinks=True)
    run(["chown", "-R", "root:root", ZAPRET_DIR])
    os.makedirs(ZAPRET_DIR + "/tmp", exist_ok=True)


def cmd_install():
    event("step", id="prepare", text="Preparing")
    workdir = tempfile.mkdtemp(prefix="zapret2-gui-")
    try:
        tag = latest_tag()
        src = download_release(workdir, tag)
        event("step", id="install", text="Installing zapret2 " + tag)
        config = preset_config(src)
        if os.path.isdir(ZAPRET_DIR):
            remove_existing()
        place_tree(src)
        with open(CONFIG, "w") as f:
            f.write(config)
        run_install_easy()

        state = load_state()
        state.update({"zapret_version": tag, "installed": int(time.time())})
        state.pop("strategy", None)
        save_state(state)
        event("done", message="zapret2 " + tag + " installed")
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


# Files install_easy.sh offers to keep when it replaces zapret2.
KEEP = ("config", "init.d/sysv/custom.d", "ipset/zapret-hosts-user.txt",
        "ipset/zapret-hosts-user-exclude.txt", "ipset/zapret-hosts-user-ipban.txt",
        "ipset/zapret-hosts-auto.txt")


def nfqws_options_valid():
    """Check the configured options with the installed nfqws2, like install_easy does."""
    opt = get_var(read_config(), "NFQWS2_OPT") or ""
    opt = opt.replace("<HOSTLIST_NOAUTO>", "").replace("<HOSTLIST>", "")
    nfqws = ZAPRET_DIR + "/nfq2/nfqws2"
    if not os.access(nfqws, os.X_OK):
        return True  # install_easy.sh will set up binaries and validate itself
    r = run([nfqws, "--dry-run", "--qnum=300"] + opt.split(), stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
    return r.returncode == 0


def cmd_update():
    """Update zapret2 to the latest release, keeping config, method and lists.

    Falls back to a fresh install when zapret2 is missing or was not set up
    by this app.
    """
    state = load_state()
    if not zapret_installed() or not state.get("zapret_version"):
        cmd_install()
        return
    event("step", id="prepare", text="Checking for zapret2 updates")
    tag = latest_tag()
    if tag == state["zapret_version"]:
        log(f"zapret2 {tag} is up to date")
        event("done", message=f"zapret2 {tag} is up to date", updated=False)
        return

    workdir = tempfile.mkdtemp(prefix="zapret2-gui-")
    try:
        src = download_release(workdir, tag)
        event("step", id="install", text=f"Updating zapret2 {state['zapret_version']} to {tag}")
        keep = os.path.join(workdir, "keep")
        for rel in KEEP:
            path = os.path.join(ZAPRET_DIR, rel)
            dest = os.path.join(keep, rel)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            if os.path.isdir(path):
                shutil.copytree(path, dest, symlinks=True)
            elif os.path.isfile(path):
                shutil.copy2(path, dest)
        was_enabled = state.get("enabled", True)
        service("stop")
        shutil.rmtree(ZAPRET_DIR)
        place_tree(src)
        for rel in KEEP:
            path, saved = os.path.join(ZAPRET_DIR, rel), os.path.join(keep, rel)
            if os.path.isdir(saved):
                shutil.rmtree(path, ignore_errors=True)
                shutil.copytree(saved, path, symlinks=True)
            elif os.path.isfile(saved):
                shutil.copy2(saved, path)

        # Put the new binaries in place, then make sure the saved method is
        # still accepted. If not, fall back to zapret2's defaults.
        run(["sh", ZAPRET_DIR + "/install_bin.sh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            cwd=ZAPRET_DIR)
        reset = False
        if not nfqws_options_valid():
            log("the saved method is not accepted by the new zapret2, using defaults")
            with open(CONFIG_DEFAULT) as f:
                default_opt = get_var(f.read(), "NFQWS2_OPT") or ""
            write_config(set_var(read_config(), "NFQWS2_OPT", '"' + default_opt + '"'))
            state.pop("strategy", None)
            reset = True
        run_install_easy()
        if not was_enabled:
            service("stop")
            service("disable")
        state["zapret_version"] = tag
        save_state(state)
        msg = f"zapret2 updated to {tag}"
        if reset:
            msg += ". Please find a working method again."
        event("done", message=msg, updated=True, reset=reset)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


# ---------------------------------------------------------------- blockcheck

def normalize_domain(raw):
    d = raw.strip().lower()
    d = re.sub(r"^[a-z][a-z0-9+.\-]*://", "", d)
    d = d.split("/", 1)[0].split("?", 1)[0].split("#", 1)[0]
    d = d.rsplit("@", 1)[-1]
    d = re.sub(r":\d+$", "", d).strip(".")
    try:
        d = d.encode("idna").decode("ascii")
    except UnicodeError:
        return None
    return d if DOMAIN_RE.match(d) else None


def run_blockcheck(domain, test, on_tested):
    """Run blockcheck2.sh for one TLS test. Returns a dict describing the outcome."""
    env = dict(os.environ,
               BATCH="1", TEST="standard", DOMAINS=domain, IPVS="4",
               ENABLE_HTTP="0", ENABLE_HTTP3="0",
               ENABLE_HTTPS_TLS12="1" if test == "tls12" else "0",
               ENABLE_HTTPS_TLS13="1" if test == "tls13" else "0",
               REPEATS="1", PARALLEL="0", SCANLEVEL="veryquick", SKIP_IPBLOCK="1")
    tf = "curl_test_https_" + test
    tested = re.compile(rf"^- {tf} ipv4 ")

    def on_line(line):
        if tested.match(line):
            on_tested()

    code, lines = stream(["sh", ZAPRET_DIR + "/blockcheck2.sh"], env=env, timeout=3600,
                         on_line=on_line, cwd=ZAPRET_DIR)
    res = {"code": code, "strategies": [], "unblocked": False, "aborted": None,
           "dns_spoofed": any("POSSIBLE DNS HIJACK DETECTED" in l for l in lines),
           "tls_unsupported": any("curl version does not support TLS 1.3" in l for l in lines)}
    try:
        start = len(lines) - 1 - lines[::-1].index("* SUMMARY")
    except ValueError:
        tail = [l for l in lines if l.strip()][-3:]
        raise Fail("blockcheck", "The test stopped unexpectedly: " + (" ".join(tail) or f"code {code}"))
    prefix = f"{tf} ipv4 {domain} : "
    for line in lines[start + 1:]:
        if not line.startswith(prefix):
            continue
        val = line[len(prefix):].strip()
        if val == "working without bypass":
            res["unblocked"] = True
        elif val.startswith("test aborted"):
            res["aborted"] = val
        elif val.startswith("nfqws2 ") and not val.endswith("not working"):
            s = val[len("nfqws2 "):].strip()
            if SAFE_STRATEGY.match(s) and s not in res["strategies"]:
                res["strategies"].append(s)
    return res


MAX_DOMAINS = 10


def site_reachable(domain):
    r = run(["curl", "-sS", "-o", "/dev/null", "--max-time", "6",
             "-A", "Mozilla", "https://" + domain + "/"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # 0 = any HTTP answer. Other codes mean the connection failed.
    return r.returncode == 0


def check_sites(domains):
    """Which domains open right now, checked in parallel."""
    with ThreadPoolExecutor(max_workers=min(8, len(domains))) as ex:
        return [d for d, ok in zip(domains, ex.map(site_reachable, domains)) if ok]


def join_names(names):
    return names[0] if len(names) == 1 else ", ".join(names[:-1]) + " and " + names[-1]


def cmd_blockcheck(raw_domains):
    """Find a method for one or more domains.

    blockcheck only runs for the first domain that is actually blocked, which
    keeps the search as fast as with a single domain. Every method it finds is
    then tried on the real service against all domains (quick parallel checks),
    and the one that opens the most of them is kept.
    """
    if not raw_domains:
        raise Fail("domain", "No website given.")
    domains = []
    for raw in raw_domains[:MAX_DOMAINS]:
        d = normalize_domain(raw)
        if not d:
            raise Fail("domain", f"\"{raw.strip()}\" doesn't look like a website address. "
                                 "Try something like example.com.")
        if d not in domains:
            domains.append(d)
    if not zapret_installed():
        raise Fail("missing", "zapret2 is not installed.")
    for tools in (("curl",), ("nslookup", "host")):
        if not any(shutil.which(t) for t in tools):
            raise Fail("prereq", f"The program '{tools[0]}' is missing. Run install.sh again to fix this.")

    previous = read_config()
    try:
        with open(USER_HOSTLIST) as f:
            previous_hosts = f.read()
    except OSError:
        previous_hosts = None
    state = load_state()
    was_running = nfqws_running()
    restored = False

    def restore():
        nonlocal restored
        if restored:
            return
        restored = True
        write_config(previous)
        if previous_hosts is not None:
            with open(USER_HOSTLIST, "w") as f:
                f.write(previous_hosts)
        trial_stop()
        if was_running:
            service_restart_checked()

    event("step", id="stop", text="Pausing bypass while testing")
    service("stop")
    time.sleep(0.5)

    tested = [0]

    def on_tested():
        tested[0] += 1
        event("progress", tested=tested[0])

    try:
        res = target = None
        unblocked, unresolved, unreachable = [], [], []
        dns_spoofed = False
        for dom in domains:
            event("step", id="search", text="Looking for a method that works for " + dom)
            r = run_blockcheck(dom, "tls12", on_tested)
            dns_spoofed = dns_spoofed or r["dns_spoofed"]
            if r["unblocked"]:
                log(f"{dom} is not blocked, trying the next website")
                unblocked.append(dom)
                continue
            if r["aborted"]:
                m = re.search(r"curl code (\d+)", r["aborted"])
                (unresolved if m and m.group(1) == "6" else unreachable).append(dom)
                continue
            if not r["strategies"]:
                event("step", id="search13", text="Trying more methods")
                r13 = run_blockcheck(dom, "tls13", on_tested)
                if not r13["tls_unsupported"]:
                    dns_spoofed = dns_spoofed or r13["dns_spoofed"]
                    r = r13
            res, target = r, dom
            break

        if res is None:
            if unblocked and not unresolved and not unreachable:
                many = len(unblocked) > 1
                raise Fail("unblocked", f"{join_names(unblocked)} {'open' if many else 'opens'} fine without "
                                        "any help, so there is nothing to find. "
                                        "Enter a website that does not open for you.")
            parts = []
            if unresolved:
                parts.append(f"{join_names(unresolved)} could not be found. Check for typos.")
            if unreachable:
                parts.append(f"{join_names(unreachable)} could not be reached at all.")
            if unblocked:
                parts.append(f"{join_names(unblocked)} {'are' if len(unblocked) > 1 else 'is'} not blocked.")
            code = "resolve" if unresolved and not unreachable else "unreachable"
            raise Fail(code, " ".join(parts))
        if not res["strategies"]:
            raise Fail("notfound", "No working method was found for " + target + ". "
                                   "Your provider may block it by address, which zapret2 cannot bypass.")

        event("step", id="apply", text="Checking the method with your websites" if len(domains) > 1
              else "Applying and checking")
        add_user_domains(domains)
        best, best_ok, applied = None, [], None
        for strategy in res["strategies"][:6]:
            log("trying: " + strategy)
            apply_profile(strategy)
            applied = strategy
            if not trial_start():
                log("zapret2 did not start with this method")
                continue
            ok = check_sites(domains)
            log(f"opens {len(ok)} of {len(domains)}: {', '.join(ok) or 'none'}")
            if best is None or len(ok) > len(best_ok):
                best, best_ok = strategy, ok
            if len(ok) == len(domains):
                break
        trial_stop()
        if best is None:
            raise Fail("notfound", "A method was found but could not be applied. Please try again.")
        if applied != best:
            apply_profile(best)
        if not service_restart_checked():
            raise Fail("notfound", "A method was found but could not be applied. Please try again.")

        failing = [d for d in domains if d not in best_ok]
        service("enable")
        restored = True
        state.update({"strategy": best, "domain": target, "domains": domains, "working": best_ok,
                      "failing": failing, "updated": int(time.time()), "enabled": True,
                      "dns_spoofed": bool(dns_spoofed)})
        save_state(state)
        event("done", message="Working method applied", domains=domains, working=best_ok,
              failing=failing, strategy=best, dns_spoofed=bool(dns_spoofed))
    finally:
        if not restored:
            restore()


# ---------------------------------------------------------------- on/off

def cmd_enable():
    if not zapret_installed():
        raise Fail("missing", "zapret2 is not installed.")
    service("enable")
    if not service_restart_checked():
        raise Fail("service", "zapret2 could not be started.")
    state = load_state()
    state["enabled"] = True
    save_state(state)
    event("done", message="Bypass is on")


def cmd_disable():
    service("stop")
    service("disable")
    state = load_state()
    state["enabled"] = False
    save_state(state)
    event("done", message="Bypass is off")


def cmd_uninstall():
    event("step", id="uninstall", text="Removing zapret2")
    if os.path.isdir(ZAPRET_DIR):
        service("stop")
        remove_existing()
    for unit in ("zapret2.service", "zapret2-list-update.service", "zapret2-list-update.timer"):
        for d in ("/etc/systemd/system", "/lib/systemd/system", "/usr/lib/systemd/system"):
            p = os.path.join(d, unit)
            if os.path.isfile(p):
                os.remove(p)
    if os.path.islink("/etc/init.d/zapret2"):
        os.remove("/etc/init.d/zapret2")
    if has_systemd():
        run(["systemctl", "daemon-reload"])
    shutil.rmtree(STATE_DIR, ignore_errors=True)
    event("done", message="zapret2 removed")


# ---------------------------------------------------------------- main

def main(argv):
    global PLAIN
    args = [a for a in argv if a != "--plain"]
    PLAIN = len(args) != len(argv)
    if os.geteuid() != 0:
        print("must run as root", file=sys.stderr)
        return 2
    if not args or args[0] not in ("install", "update", "blockcheck", "enable", "disable", "uninstall"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    os.umask(0o022)
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, _on_signal)
    # Writing to a closed pipe must raise, not kill us before cleanup.
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)

    cmd = args[0]
    try:
        lock = take_lock()
        try:
            if cmd == "install":
                cmd_install()
            elif cmd == "update":
                cmd_update()
            elif cmd == "blockcheck":
                cmd_blockcheck(args[1:])
            elif cmd == "enable":
                cmd_enable()
            elif cmd == "disable":
                cmd_disable()
            elif cmd == "uninstall":
                cmd_uninstall()
        finally:
            os.close(lock)
        return 0
    except Fail as e:
        try:
            event("error", code=e.code, message=str(e))
        except Aborted:
            pass
        return 1
    except Aborted:
        # stdout is a dead pipe; keep the interpreter from failing on exit flush.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        return 3


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
