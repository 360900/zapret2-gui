    def add_entry(self, text="", focus=False):
        if len(self.entries) >= MAX_DOMAINS:
            return None
        first = not self.entries
        row = Adw.EntryRow(title="Website, for example discord.com" if first else "Another website")
        row.set_input_purpose(Gtk.InputPurpose.URL)
        row.set_text(text)
        row.connect("entry-activated", lambda _e: self.start_blockcheck())
        row.connect("changed", lambda _e: self._update_start())
        if not first:
            rm = Gtk.Button(icon_name="list-remove-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Remove")
            rm.add_css_class("flat")
            rm.connect("clicked", lambda _b, r=row: self.remove_entry(r))
            row.add_suffix(rm)
        self.domain_list.insert(row, len(self.entries))
        self.entries.append(row)
        self.add_row.set_visible(len(self.entries) < MAX_DOMAINS)
        self._update_start()
        if focus:
            row.grab_focus()
        return row

    def remove_entry(self, row):
        if row in self.entries[1:]:
            self.entries.remove(row)
            self.domain_list.remove(row)
            self.add_row.set_visible(True)
            self._update_start()

    def set_domains(self, domains):
        for row in self.entries[1:]:
            self.domain_list.remove(row)
        del self.entries[1:]
        self.entry.set_text(domains[0] if domains else "")
        for d in domains[1:MAX_DOMAINS]:
            self.add_entry(d)
        self.add_row.set_visible(len(self.entries) < MAX_DOMAINS)

